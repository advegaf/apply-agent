# config.env.example — copy to agent/config.env (gitignored).

# ntfy.sh push topic. Pick something unguessable: anyone who knows the topic can
# read your alerts. Unset is fine; the pipeline falls back to a local banner.
NTFY_TOPIC=

# Which listings feed and term to watch.
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json
TERM_FILTER=Summer 2027

# Companies you will not work for, comma separated, lowercase.
EXCLUDED_COMPANIES=

# Path to the claude CLI. Leave unset to use whatever is on PATH.
# CLAUDE=/opt/homebrew/bin/claude
