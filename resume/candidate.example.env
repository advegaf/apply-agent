# candidate.example.env — copy to candidate.env (gitignored) and edit.
# Values about YOU that build.sh's gates assert. Fictional examples below.

# Filename for the employer-facing variant (the one that genericises current-job detail)
OUT_EMPLOYER="Resume_Employer.pdf"

# Facts that must appear in the first ~120 words of every PDF. This is the
# 7-second scan floor: school, graduation, best-known employer, best award.
# Space-separated, quote each multi-word fact.
SCAN_FLOOR_FACTS='"State University" "May 2027" "Acme Corp" "1st Place"'

# The graduation string every variant must contain, and the one none may contain.
GRAD_REQUIRED="May 2027"
GRAD_FORBIDDEN="December 2026"

# Output filenames. The packet copy is deliberately company-neutral: it sorts
# under your surname, names you and the role without being opened, and never
# carries a company name in filename or PDF metadata.
CANDIDATE_NAME="Jordan Rivera"
OUT_IOS="Jordan_Rivera_Resume_iOS.pdf"
OUT_BACKEND="Jordan_Rivera_Resume_Backend.pdf"
OUT_PRODUCT="Jordan_Rivera_Resume_Product.pdf"
NEUTRAL_NAME="Jordan_Rivera_Resume_SWE_Intern.pdf"

# Provisional-number warnings. build.sh prints a reminder on every build for any
# figure you have not yet measured, so the reminder never goes stale silently.
# One grep-able substring per line in provisional.conf (gitignored).
